diff --git a/internal/engine/jitsi/epoch.go b/internal/engine/jitsi/epoch.go
index 288fdd4..dab0be3 100644
--- a/internal/engine/jitsi/epoch.go
+++ b/internal/engine/jitsi/epoch.go
@@ -131,12 +131,29 @@ func (s *Session) acceptEpochFrame(payload []byte) ([]byte, bool) {
 	senderEpoch, receiverEpoch := frame.senderEpoch, frame.receiverEpoch
 
 	if s.requireTargetedPeer && s.onPeerData == nil {
+		confirmed := s.peerEpoch.Load()
 		if receiverEpoch != s.localEpoch.Load() {
-			logger.Debugf("jitsi: drop untargeted bridge frame senderEpoch=0x%08x localEpoch=0x%08x",
-				senderEpoch, s.localEpoch.Load())
-			return nil, false
+			// Untargeted (broadcast) frame: the sender does not know our
+			// localEpoch yet. Accept it while unlatched (confirmed==0) so
+			// WaitForPeer can latch the peer from its first frame - on cold
+			// start and after every reconnect the peer's first frame is a
+			// broadcast Send(nil). Dropping it wedges WaitForPeer for its
+			// whole timeout ("ping works, no connection"). Once latched, only
+			// broadcasts from the latched sender pass; anything else is a
+			// third-party/ghost.
+			if confirmed != 0 && senderEpoch != confirmed {
+				logger.Debugf("jitsi: drop untargeted bridge frame senderEpoch=0x%08x localEpoch=0x%08x",
+					senderEpoch, s.localEpoch.Load())
+				return nil, false
+			}
+			if confirmed == 0 {
+				s.peerEpoch.Store(senderEpoch)
+			}
+			return frame.body, true
 		}
-		if confirmed := s.peerEpoch.Load(); confirmed != 0 && senderEpoch != confirmed {
+		// Targeted frame for our localEpoch. It proves the bridge is alive but
+		// must not bind the peer before the authenticated welcome confirms it.
+		if confirmed != 0 && senderEpoch != confirmed {
 			logger.Debugf("jitsi: drop frame from unauthenticated peer senderEpoch=0x%08x peerEpoch=0x%08x",
 				senderEpoch, confirmed)
 			return nil, false
